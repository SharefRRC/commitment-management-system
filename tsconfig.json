{
"compilerOptions": {
"target": "ES2020",
"module": "CommonJS",
"rootDir": ".",
"outDir": "./dist",
"strict": true,
"esModuleInterop": true,
"moduleResolution": "node",
"resolveJsonModule": true,
"forceConsistentCasingInFileNames": true,
"skipLibCheck": true,
"types": ["node", "jest"],
"sourceMap": true
},
"include": ["src/**/*.ts", "tests/**/*.ts"],
"exclude": ["node_modules", "dist"]
}
